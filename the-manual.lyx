\end_inset


\end_layout

\begin_layout Paragraph
\begin_inset Formula $R=\left\{ r_{1},r_{2},...,r_{n}\right\} $
\end_inset


\end_layout

\begin_layout Paragraph
\begin_inset Formula $r_{i}∈\mathit{{FsDiffRecord}}$
\end_inset


\end_layout

