\begin_layout Paragraph
Where:
\end_layout

\begin_layout Paragraph
Trees are partial functions from paths to entries:
\end_layout

\begin_layout Paragraph
\begin_inset Formula $Tree_{a},Tree_{b}∈P⇀E$
\end_inset

 
